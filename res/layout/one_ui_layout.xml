<com.android.camera.ui.OneUICameraControls xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:camera="http://schemas.android.com/apk/res-auto"
    android:id="@+id/camera_controls"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:focusable="true"
    android:focusableInTouchMode="true"
    tools:ignore="MissingClass">

    <com.android.camera.ui.ProMode
        android:id="@+id/promode_slider"
        android:layout_height="wrap_content"
        android:layout_width="wrap_content" />

    <com.android.camera.ui.AIBlurConfigSlide
        android:id="@+id/aiblur_slide"
        android:layout_height="wrap_content"
        android:layout_width="wrap_content" />

    <com.android.camera.ui.FlashToggleButton
        android:id="@+id/flash_button"
        style="@style/OneUIMenuButton"
        android:src="@drawable/flash" />

    <TextView
        android:id="@+id/video_photo_size"
        android:layout_width="80dp"
        android:layout_height="wrap_content"
        android:background="@android:color/transparent"
        android:textColor="@android:color/white"
        android:clickable="true"
        android:textSize="15sp"
        android:gravity="center"
        android:text="1080p"
        android:visibility="visible" />

    <TextView
        android:id="@+id/video_fps"
        android:layout_width="80dp"
        android:layout_height="wrap_content"
        android:background="@android:color/transparent"
        android:textColor="@android:color/white"
        android:clickable="true"
        android:textSize="15sp"
        android:gravity="center"
        android:text="120fps"
        android:visibility="visible" />

    <com.android.camera.ui.RotateImageView
        android:id="@+id/mute_button"
        style="@style/OneUIMenuButton"
        android:contentDescription="@string/mute_button_desc"
        android:src="@drawable/ic_unmuted_button"
        android:visibility="gone" />

    <ProgressBar
        android:id="@+id/progress_bar"
        android:layout_width="150dp"
        android:layout_height="150dp"
        android:layout_gravity="center_horizontal|center_vertical"
        android:visibility="gone"
        android:indeterminate="true"
        android:indeterminateTint="#f44242" />

    <com.android.camera.ShutterButton
        android:id="@+id/shutter_button"
        android:layout_width="@dimen/one_ui_bottom_large"
        android:layout_height="@dimen/one_ui_bottom_large"
        android:clickable="true"
        android:contentDescription="@string/accessibility_shutter_button"
        android:focusable="true"
        android:scaleType="fitCenter"
        android:src="@drawable/photo_capture" />
    <com.android.camera.ui.ShutterButtonAnim
        android:id="@+id/shutterbutton_anim"
        android:layout_width="@dimen/one_ui_bottom_large"
        android:layout_height="@dimen/one_ui_bottom_large" />
    <com.android.camera.ui.RotateImageView
        android:id="@+id/longshutter_stopbutton"
        android:layout_width="@dimen/one_ui_bottom_large"
        android:layout_height="@dimen/one_ui_bottom_large"
        android:clickable="true"
        android:contentDescription="@string/accessibility_shutter_button"
        android:focusable="true"
        android:scaleType="fitCenter"
        android:visibility="gone"
        android:src="@drawable/video_stop" />
    <com.android.camera.ui.RotateImageView
        android:id="@+id/video_button"
        android:layout_width="@dimen/one_ui_bottom_large"
        android:layout_height="@dimen/one_ui_bottom_large"
        android:clickable="true"
        android:contentDescription="@string/accessibility_shutter_button"
        android:focusable="true"
        android:scaleType="fitCenter"
        android:visibility="gone"
        android:src="@drawable/video_capture" />

    <com.android.camera.PauseButton
        android:id="@+id/video_pause"
        android:layout_width="@dimen/one_ui_bottom_small"
        android:layout_height="@dimen/one_ui_bottom_small"
        android:focusable="true"
        android:clickable="true"
        android:scaleType="fitCenter"
        android:visibility="gone"
        android:src="@drawable/btn_pause_recording"/>

    <com.android.camera.ui.RotateImageView
        android:id="@+id/cancel_button"
        android:layout_width="@dimen/one_ui_bottom_small"
        android:layout_height="@dimen/one_ui_bottom_small"
        android:clickable="true"
        android:focusable="true"
        android:scaleType="fitCenter"
        android:visibility="gone"
        android:src="@drawable/ic_menu_cancel_holo_light" />

    <com.android.camera.ui.RotateImageView
        android:id="@+id/front_back_switcher"
        android:layout_width="@dimen/one_ui_bottom_small"
        android:layout_height="@dimen/one_ui_bottom_small"
        android:focusable="true"
        android:clickable="true"
        android:scaleType="fitCenter"
        android:visibility="gone"
        android:src="@drawable/front_back_camera" />

    <com.android.camera.ui.RotateImageView
        android:id="@+id/preview_thumb"
        android:layout_width="@dimen/capture_size"
        android:layout_height="@dimen/capture_size"
        android:layout_gravity="top|left"
        android:background="@android:color/transparent"
        android:contentDescription="@string/switch_photo_filmstrip"
        android:scaleType="fitCenter" />

    <com.android.camera.ui.RotateImageView
        android:id="@+id/exit_best_mode"
        android:layout_width="25dp"
        android:layout_height="25dp"
        android:clickable="true"
        android:contentDescription="@string/accessibility_exit_best_mode_button"
        android:focusable="true"
        android:layout_gravity="top|left"
        android:scaleType="fitCenter"
        android:src="@drawable/x"
        android:visibility="gone"/>

    <com.android.camera.ui.RotateImageView
        android:id="@+id/hdr_switcher"
        style="@style/OneUIMenuButton" />

    <com.android.camera.ui.RotateImageView
        android:id="@+id/scene_mode_switcher"
        style="@style/OneUIMenuButton"
        android:src="@drawable/more_options" />

    <com.android.camera.ui.RotateImageView
        android:id="@+id/scene_mode_hdr"
        style="@style/OneUIMenuButton"
        android:src="@drawable/ic_hdr_off" />

    <com.android.camera.ui.RotateImageView
        android:id="@+id/filter_mode_switcher"
        style="@style/OneUIMenuButton"
        android:src="@drawable/filters" />

    <com.android.camera.ui.RotateImageView
        android:id="@+id/ts_makeup_switcher"
        style="@style/OneUIMenuButton" />

    <com.android.camera.ui.RotateImageView
        android:id="@+id/settings"
        style="@style/OneUIMenuButton" />

    <LinearLayout
        android:id="@+id/remaining_photos"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@android:color/transparent"
        android:orientation="horizontal"
        android:visibility="gone">

        <TextView
            android:id="@+id/remaining_photos_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@android:color/transparent"
            android:textColor="@android:color/white"
            android:visibility="gone" />

        <ImageView
            android:id="@+id/remaining_photos_image"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/remaining_sheets"
            android:visibility="gone" />
    </LinearLayout>

    <ImageView
        android:id="@+id/pro_setting_reset"
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:src="@drawable/restore_white"
        android:layout_marginTop="70dp"
        android:layout_marginLeft="20dp"
        android:clickable="true"
        android:visibility="gone" />

    <include layout="@layout/pro_mode_layout" />
    <include layout="@layout/ai_blur_layout" />

    <SeekBar
        android:layout_width="320dp"
        android:layout_height="40dp"
        android:maxHeight="3dip"
        android:minHeight="1dip"
        android:visibility="gone"
        android:layout_gravity="center_horizontal|bottom"
        android:layout_marginBottom="90dp"
        android:progressDrawable="@drawable/beautify_progressbar_style"
        android:thumb="@drawable/ic_beautify_oval"
        android:id="@+id/deepportrait_seekbar"/>
    <LinearLayout
        android:id="@+id/zoom_text_layout"
        android:layout_width="150dip"
        android:layout_height="40dip"
        android:background="@drawable/oval_background"
        android:layout_gravity="center_horizontal|bottom"
        android:layout_marginBottom="160dp"
        android:gravity="center_vertical"
        android:visibility="gone"
        android:orientation="horizontal">
        <TextView
            android:id="@+id/zoom_uw"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:textSize="15sp"
            android:alpha="0.7"
            android:clickable="true"
            android:text="0.67x"
            android:layout_weight="1"
            android:gravity="center"
            android:textColor="@color/mode_text_selector">
        </TextView>
        <TextView
            android:id="@+id/zoom_w"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:textSize="15sp"
            android:alpha="0.7"
            android:clickable="true"
            android:text="1.00x"
            android:layout_weight="1"
            android:gravity="center"
            android:textColor="@color/mode_text_selector">
        </TextView>
        <TextView
            android:id="@+id/zoom_tel"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:textSize="15sp"
            android:alpha="0.7"
            android:clickable="true"
            android:text="2.50x"
            android:layout_weight="1"
            android:gravity="center"
            android:textColor="@color/mode_text_selector">
        </TextView>
    </LinearLayout>
        <com.android.camera.ui.ZoomBarView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal|bottom"
            android:layout_marginBottom="140dp"
            android:visibility="gone"
            android:paddingTop="5dp"
            android:paddingBottom="5dp"
            android:id="@+id/zoom_seekbar"/>
    <RelativeLayout
        android:id="@+id/manual_flash_layout"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@android:color/transparent"
        android:layout_marginTop="50dp"
        android:layout_marginLeft="200dp"
        android:visibility="gone"
        android:orientation="vertical"
   >
    <SeekBar
        android:layout_width="140dp"
        android:layout_height="50dp"
        android:maxHeight="3dip"
        android:minHeight="1dip"
        android:paddingTop="5dp"
        android:progressDrawable="@drawable/beautify_progressbar_style"
        android:thumb="@drawable/evbar_thumb"
        android:thumbOffset="0dp"
        android:id="@+id/flash_seekbar">
    </SeekBar>
        <TextView
            android:id="@+id/flash_min_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="14dip"
            android:paddingLeft="5dp"
            android:paddingTop="17dp"
            android:alpha="0.7"
            android:gravity="center"
            android:text="1"
            android:textColor="@android:color/white">
        </TextView>
        <TextView
            android:id="@+id/flash_max_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="14dip"
            android:paddingLeft="129dp"
            android:paddingTop="17dp"
            android:alpha="0.7"
            android:gravity="center"
            android:text="5"
            android:textColor="@android:color/white">
        </TextView>
        <TextView
            android:id="@+id/flash_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="14dip"
            android:paddingLeft="70dp"
            android:paddingTop="28dp"
            android:alpha="0.7"
            android:gravity="center"
            android:text="1"
            android:textColor="@android:color/white">
        </TextView>
    </RelativeLayout>


    <TextView
        android:id="@+id/zoom_value_text"
        android:layout_width="52dip"
        android:layout_height="30dip"
        android:textSize="14dip"
        android:layout_gravity="center_horizontal|bottom"
        android:alpha="0.7"
        android:gravity="center"
        android:clickable="true"
        android:layout_marginBottom="340dp"
        android:textColor="@android:color/white">
    </TextView>

    <LinearLayout
        android:id="@+id/zoom_edit_layout"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal|bottom"
        android:layout_marginBottom="150dp"
        android:gravity="center_vertical"
        android:visibility="gone"
        android:orientation="horizontal">
        <EditText
            android:id="@+id/zoom_edit_text"
            android:layout_width="120dp"
            android:layout_height="wrap_content"
            android:hint="Enter zoom"
            android:inputType="numberDecimal" />
        <RelativeLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">
            <TextView
                android:id="@+id/gozoom"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="GO"
                android:background="@drawable/circle_background"
                android:layout_centerInParent="true"
                android:gravity="center"
                android:padding="10dp"
                android:textSize="14dip" />
        </RelativeLayout>

    </LinearLayout>

        <SeekBar
            android:layout_width="140dp"
            android:layout_height="50dp"
            android:maxHeight="3dip"
            android:minHeight="1dip"
            android:visibility="gone"
            android:paddingTop="1dp"
            android:progressDrawable="@drawable/beautify_progressbar_style"
            android:thumb="@drawable/evbar_thumb"
            android:thumbOffset="0dp"
            android:id="@+id/ev_seekbar">
        </SeekBar>
    <LinearLayout
        android:id="@+id/ev_layout"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_vertical|right"
        android:layout_marginRight="2dp"
        android:orientation="vertical"
        android:visibility="gone">
        <RelativeLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">
            <TextView
                android:id="@+id/ev_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="EV"
                android:textColor="@color/mode_text_selector"
                android:background="@drawable/circle_background"
                android:layout_centerInParent="true"
            android:gravity="center"
            android:padding="10dp"
            android:visibility="gone"
            android:textSize="14dip" />
        </RelativeLayout>
    <com.android.camera.ui.VerticalSeekBar
        android:id="@+id/ev_verticalbar"
        android:layout_width="50dp"
        android:layout_height="140dp"
        android:maxHeight="3dip"
        android:minHeight="1dip"
        android:layout_gravity="center_vertical|right"
        android:layout_marginRight="2dp"
        android:thumbOffset="0dp"
        android:progressDrawable="@drawable/beautify_progressbar_style"
        android:thumb="@drawable/evbar_thumb"
        android:max = "100"
        android:visibility="gone"
        tools:ignore="MissingClass" >
    </com.android.camera.ui.VerticalSeekBar>

    </LinearLayout>>

    <TextView
        android:id="@+id/vsr_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="84dip"
        android:layout_marginLeft="30dip"
        android:alpha="0.7"
        android:text="VSR"
        android:textColor="@android:color/white"
        android:visibility="gone"
        android:clickable="false"
        android:textSize="14dip" />

    <LinearLayout
        android:id="@+id/aistrength"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_vertical|left"
        android:layout_marginLeft="2dp"
        android:orientation="vertical"
        android:visibility="gone">
        <TextView
            android:id="@+id/aistrength_value"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="4dp"
            android:alpha="0.7"
            android:text="AI 128"
            android:textColor="@android:color/white"
            android:visibility="gone"
            android:layout_above="@+id/aicamera_seekbar"
            android:clickable="true"
            android:textSize="14dip" />
        <com.android.camera.ui.VerticalSeekBar
            android:id="@+id/aicamera_seekbar"
            android:layout_width="40dp"
            android:layout_height="140dp"
            android:maxHeight="3dip"
            android:minHeight="1dip"
            android:layout_gravity="center_vertical|left"
            android:layout_marginLeft="2dp"
            android:thumbOffset="0dp"
            android:progressDrawable="@drawable/beautify_progressbar_style"
            android:thumb="@drawable/evbar_thumb"
            android:max = "100"
            android:visibility="gone"
            tools:ignore="MissingClass" >
        </com.android.camera.ui.VerticalSeekBar>

    </LinearLayout>
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone"
        android:id="@+id/torch_mode_body">
        <com.android.camera.ui.VerticalSeekBar
            android:id="@+id/torch_verticalbar"
            android:layout_width="50dp"
            android:layout_height="140dp"
            android:maxHeight="3dip"
            android:minHeight="1dip"
            android:layout_centerHorizontal="true"
            android:layout_centerVertical="true"
            android:thumbOffset="0dp"
            android:progressDrawable="@drawable/beautify_progressbar_style"
            android:thumb="@drawable/evbar_thumb"
            android:max = "100"
            tools:ignore="MissingClass" >
        </com.android.camera.ui.VerticalSeekBar>
        <TextView
            android:id="@+id/torch_bar_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerHorizontal="true"
            android:layout_centerVertical="true"
            android:layout_above="@+id/torch_verticalbar"
            android:alpha="0.7"
            android:clickable="true"
            android:gravity="center"
            android:text="3"
            android:textColor="@android:color/white"
            android:textSize="20sp" />
        <TextView
            android:id="@+id/torch_level_apply"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerHorizontal="true"
            android:layout_centerVertical="true"
            android:layout_toRightOf="@+id/torch_bar_text"
            android:layout_alignBottom="@+id/torch_bar_text"
            android:alpha="0.7"
            android:clickable="true"
            android:gravity="center"
            android:text="Apply"
            android:textColor="@android:color/white"
            android:background="#D3D3D3"
            android:textSize="20sp" />
        <TextView
            android:id="@+id/torch_read_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerHorizontal="true"
            android:layout_centerVertical="true"
            android:layout_toLeftOf="@+id/torch_verticalbar"
            layout_alignBottom="@+id/torch_verticalbar"
            android:alpha="0.7"
            android:clickable="true"
            android:gravity="center"
            android:text="getTorchLevel"
            android:textColor="@android:color/white"
            android:background="#D3D3D3"
            android:textSize="20sp" />
        <TextView
            android:id="@+id/torch_open_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerHorizontal="true"
            android:layout_toLeftOf="@+id/torch_verticalbar"
            android:layout_alignBottom ="@+id/torch_verticalbar"
            android:alpha="0.7"
            android:clickable="true"
            android:gravity="center"
            android:text="openTorch"
            android:textColor="@android:color/white"
            android:background="#D3D3D3"
            android:textSize="20sp" />
        <TextView
            android:id="@+id/torch_level_value"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerHorizontal="true"
            android:layout_centerVertical="true"
            android:layout_below="@+id/torch_read_text"
            android:layout_toLeftOf="@+id/torch_verticalbar"
            android:alpha="0.7"
            android:clickable="true"
            android:gravity="center"
            android:text="3"
            android:textColor="@android:color/white"
            android:textSize="20sp" />
        <TextView
            android:id="@+id/torch_close_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerHorizontal="true"
            android:layout_toRightOf="@+id/torch_verticalbar"
            android:layout_alignBottom ="@+id/torch_verticalbar"
            android:alpha="0.7"
            android:clickable="true"
            android:gravity="center"
            android:text="closeTorch"
            android:textColor="@android:color/white"
            android:background="#D3D3D3"
            android:textSize="20sp" />
    </RelativeLayout>
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:id="@+id/makeup_seekbar_layout"
        android:visibility="gone">
        <ImageView
            android:layout_width="30dp"
            android:layout_height="40dp"
            android:layout_marginLeft="20dp"
            android:layout_marginRight="10dp"
            android:src="@drawable/seekbar_hide"
            android:id="@+id/seekbar_toggle">
        </ImageView>
        <RelativeLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:id="@+id/seekbar_body">
            <com.android.camera.ui.RotateLayout
                android:layout_width="30dp"
                android:layout_height="40dp"
                android:layout_alignParentLeft="true"
                android:id="@+id/makeup_low_text">
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:textSize="12sp"
                    android:gravity="center"
                    android:text="@string/makeup_seekbar_low"
                    android:textColor="@android:color/white">
                </TextView>
            </com.android.camera.ui.RotateLayout>
            <SeekBar
                android:layout_width="220dp"
                android:layout_height="40dp"
                android:maxHeight="3dip"
                android:minHeight="1dip"
                android:layout_marginLeft="10dp"
                android:layout_toRightOf="@+id/makeup_low_text"
                android:progressDrawable="@drawable/beautify_progressbar_style"
                android:thumb="@drawable/ic_beautify_oval"
                android:id="@+id/makeup_seekbar"/>
            <com.android.camera.ui.RotateLayout
                android:layout_width="30dp"
                android:layout_height="40dp"
                android:layout_toRightOf="@+id/makeup_seekbar"
                android:layout_marginLeft="10dp"
                android:id="@+id/makeup_high_text">
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:textSize="12sp"
                    android:gravity="center"
                    android:text="@string/makeup_seekbar_high"
                    android:textColor="@android:color/white">
                </TextView>
            </com.android.camera.ui.RotateLayout>
        </RelativeLayout>
    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:layout_marginBottom="110dp">

        <android.support.v7.widget.RecyclerView
            android:id="@+id/mode_select_layout"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal|bottom"
            android:layout_centerHorizontal="true"
            android:scrollbars="none" />

    </FrameLayout>

</com.android.camera.ui.OneUICameraControls>
