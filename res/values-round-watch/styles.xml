<resources xmlns:xliff="urn:oasis:names:tc:xliff:document:1.2">
    <!-- use new ActionBar stytle for SettingsActivity and MultiSettingsActivity
         for circular display -->
    <style name="Theme.Settings" parent="@android:style/Theme.Material.Light">
        <item name="android:colorAccent">#5999e1</item>
        <item name="android:actionBarStyle">@style/AppSettings.ActionBar</item>
    </style>
    <style name="AppSettings.ActionBar" parent="android:Widget.Material.Light.ActionBar">
        <item name="android:displayOptions">disableHome|showTitle</item>
    </style>

    <style name="OneUIMenuButton">
        <item name="android:layout_width">@dimen/oneui_menu_button_size</item>
        <item name="android:layout_height">@dimen/oneui_menu_button_size</item>
        <item name="android:scaleType">fitCenter</item>
    </style>
</resources>
